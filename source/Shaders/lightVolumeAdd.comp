#version 450

#extension GL_GOOGLE_include_directive : enable

#include "LuzCommon.h"

layout(push_constant) uniform _constants {
    LightVolumeConstants ctx;
};

layout (local_size_x = 32, local_size_y = 32) in;
void main() {
    ivec2 pixelPos = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    if (pixelPos.x >= ctx.imageSize.x || pixelPos.y >= ctx.imageSize.y) {
        return;
    }
    
    vec4 rgba = imageLoad(images[ctx.lightRID], pixelPos);
    vec4 lightVolume = imageLoad(images[ctx.lightVolumeRID], pixelPos);
    
    // Blend using pre-multiplied alpha 
    // For premultiplied alpha: result = src + dst * (1 - src.a)
    vec3 blendedLight = lightVolume.rgb + rgba.rgb * (1.0 - lightVolume.a);
    float blendedAlpha = lightVolume.a + rgba.a * (1.0 - lightVolume.a);
    
    vec4 result = vec4(lightVolume.rgb + rgba.rgb, 1.0);
    
    imageStore(images[ctx.lightRID], pixelPos, result);
}