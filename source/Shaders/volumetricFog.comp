#version 450

#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable

#include "LuzCommon.h"

layout(push_constant) uniform _constants {
    VolumetricFogConstants ctx;
};

layout (local_size_x = 10, local_size_y = 10, local_size_z = 8) in;

float PhaseFunction(float cosTheta, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

float SampleShadowMap(LightBlock light, vec3 fragPos) {
    if (light.type == LUZ_LIGHT_TYPE_DIRECTIONAL || light.type == LUZ_LIGHT_TYPE_SUN) {
        vec4 fragInLight = (light.viewProj[0] * vec4(fragPos, 1));
        vec2 baseUV = (fragInLight.xy * 0.5 + 0.5);
        float shadowDepth = texture(textures[light.shadowMap], baseUV).r;
        return fragInLight.z >= shadowDepth ? 1.0 : 0.0;
    } else {
        vec3 lightToFrag = fragPos - light.position;
        float distanceToReceiver = length(lightToFrag);
        vec3 lightDir = normalize(lightToFrag);
        float shadowDepth = texture(cubeTextures[light.shadowMap], lightDir).r;
        return distanceToReceiver >= (shadowDepth * light.zFar) ? 1.0 : 0.0;
    }
}

vec3 GetFroxelUVW(vec3 froxelPos, vec3 froxelVolumeSize, float froxelVolumeDepth, mat4 proj, mat4 view, float camNear, float camFar) {
    // Transform world position to view space
    vec4 viewPos = view * vec4(froxelPos, 1.0);
    
    // Transform to clip space
    vec4 clipPos = proj * viewPos;
    clipPos /= clipPos.w;
    
    // Map clip space XY to UV (0 to 1)
    vec2 uv = clipPos.xy * 0.5 + 0.5;
    
    // Compute linear depth in view space (negative Z in view space)
    float linearDepth = -viewPos.z;
    
    // Map linear depth to W (0 to 1)
    // Depth is relative to froxel volume (camNear to froxelVolumeDepth)
    float w = (linearDepth - camNear) / (froxelVolumeDepth - camNear);
    
    // Clamp to ensure UVW stays within [0, 1]
    return clamp(vec3(uv, w), 0.0, 1.0);
}

vec4 BlueNoiseSample(ivec2 pixelPos, int i) {
    vec2 blueNoiseSize = textureSize(textures[scene.blueNoiseTexture], 0);
    ivec2 fragUV = ivec2(mod(pixelPos, blueNoiseSize));
    return fract(texelFetch(textures[scene.blueNoiseTexture], fragUV, 0) + GOLDEN_RATIO*(128*i + ctx.frame%128));
}

vec3 GetFroxelPos(ivec3 froxelIndex, vec3 froxelVolumeSize, float froxelVolumeDepth, mat4 proj, mat4 view, float camNear, float camFar, bool useJitter) {
    // Convert froxel index to normalized UVW (0 to 1), sampling the center of the froxel
    // Add blue noise offset for stochastic sampling
    vec4 blueNoise = BlueNoiseSample(ivec2(gl_GlobalInvocationID.xy), int(gl_GlobalInvocationID.z));
    vec3 jitter = useJitter ? (blueNoise.xyz - 0.5) * 0.9 : vec3(0.0);
    vec3 uvw = (vec3(froxelIndex) + 0.5 + jitter) / froxelVolumeSize;
    
    // Map UV to NDC space (-1 to 1)
    vec2 ndcXY = uvw.xy * 2.0 - 1.0;
    
    // Calculate linear depth from normalized W
    float linearDepth = camNear + uvw.z * (froxelVolumeDepth - camNear);
    
    // Create view space position using NDC coordinates and linear depth
    // For perspective projection, view space Z is negative
    float viewZ = -linearDepth;
    
    // Reconstruct view space position
    // X and Y depend on Z and the projection matrix
    float viewX = ndcXY.x * -viewZ / proj[0][0];
    float viewY = ndcXY.y * -viewZ / proj[1][1];
    
    vec4 viewPos = vec4(viewX, viewY, viewZ, 1.0);
    
    // Transform from view space to world space
    vec4 worldPos = inverse(view) * viewPos;

    return worldPos.xyz;
}

float GetLayerThickness(ivec3 froxelIndex, vec3 froxelVolumeSize, float zFar, mat4 proj, mat4 view, float camNear, float camFar) {
    vec3 current = GetFroxelPos(froxelIndex, froxelVolumeSize, zFar, proj, view, camNear, camFar, false);
    
    if (froxelIndex.z == 0) {
        vec3 next = GetFroxelPos(froxelIndex + ivec3(0, 0, 1), froxelVolumeSize, zFar, proj, view, camNear, camFar, false);
        return length(next - current);
    }
    
    if (froxelIndex.z == int(froxelVolumeSize.z) - 1) {
        vec3 prev = GetFroxelPos(froxelIndex - ivec3(0, 0, 1), froxelVolumeSize, zFar, proj, view, camNear, camFar, false);
        return length(current - prev);
    }
    
    vec3 prev = GetFroxelPos(froxelIndex - ivec3(0, 0, 1), froxelVolumeSize, zFar, proj, view, camNear, camFar, false);
    vec3 next = GetFroxelPos(froxelIndex + ivec3(0, 0, 1), froxelVolumeSize, zFar, proj, view, camNear, camFar, false);
    float thicknessToPrev = length(current - prev);
    float thicknessToNext = length(next - current);
    return (thicknessToPrev + thicknessToNext) * 0.5;
}

void main() {
    ivec3 gridPos = ivec3(gl_GlobalInvocationID.xyz);
    if (gridPos.x >= ctx.froxelVolumeSize.x || gridPos.y >= ctx.froxelVolumeSize.y || gridPos.z >= ctx.froxelVolumeSize.z) {
        return;
    }
    
    vec3 worldPos = GetFroxelPos(gridPos, ctx.froxelVolumeSize, ctx.zFar, scene.proj, scene.view, scene.camNear, scene.camFar, true);
    float layerThickness = GetLayerThickness(gridPos, ctx.froxelVolumeSize, ctx.zFar, scene.proj, scene.view, scene.camNear, scene.camFar);
    
    float dustDensity = ctx.density;
    
    float scattering = ctx.scattering * dustDensity * layerThickness;
    float absorption = ctx.absorption * dustDensity * layerThickness;

    vec3 viewDir = normalize((inverse(scene.view) * vec4(0.0, 0.0, 1.0, 0.0)).xyz);
    vec3 lighting = vec3(0.0);

    for (int i = 0; i < scene.numLights; i++) {
        LightBlock light = scene.lights[i];
        if (light.volumetricType != VOLUMETRIC_TYPE_FOG) {
            continue;
        }
        vec3 lightDir = normalize(light.direction);
        vec3 lightContribution = light.intensity * light.color;
        if (light.type != LUZ_LIGHT_TYPE_DIRECTIONAL && light.type != LUZ_LIGHT_TYPE_SUN) {
            vec3 lightToFrag = light.position - worldPos;
            lightDir = normalize(lightToFrag);
            lightContribution *= 1.0 / dot(lightToFrag, lightToFrag);
        }
        float cosTheta = dot(lightDir, viewDir);
        lighting += lightContribution * PhaseFunction(cosTheta, ctx.anisotropy) * (1.0 - SampleShadowMap(light, worldPos));
    }

    lighting *= ctx.albedo;

    vec4 prev = imageLoad(images3D[ctx.froxelVolumeRID], ivec3(gl_GlobalInvocationID.xyz));
    vec4 result = prev * 0.8 + 0.2 * vec4(lighting * scattering, scattering + absorption);
    imageStore(images3D[ctx.froxelVolumeRID], ivec3(gl_GlobalInvocationID.xyz), result);
}